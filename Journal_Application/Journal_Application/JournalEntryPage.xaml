<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Journal_Application.JournalEntryPage">

    <ScrollView>
        <VerticalStackLayout>
            <HorizontalStackLayout HorizontalOptions="Center"
                                   Margin="0, 20"
                                   >


                <Label Text ="Journal entries"
                       Margin="20,0"
                       FontSize="30"
                       TextColor="Black">

                </Label>


                <Label Text="To-do list"
                       FontSize="30"
                       TextColor="Black">

                </Label>



            </HorizontalStackLayout>
            <VerticalStackLayout>

                <Entry Placeholder="Write the title of the entry here...."
                       WidthRequest="650"
                       HorizontalTextAlignment="Center"
                       FontSize="18">

                </Entry>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>    

</ContentPage>
