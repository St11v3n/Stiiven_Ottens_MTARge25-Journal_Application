<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Journal_Application.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Journal_Application"
    Title="Journal_Application">

    <Tab>
        
        <ShellContent
            Title="Journal entries"
            ContentTemplate="{DataTemplate local:JournalEntryPage}"
            Route="JournalEntryPage" />

        <ShellContent
            Title="To-do list"
            ContentTemplate="{DataTemplate local:ToDoListPage}"
            Route="ToDoListPage" />

    </Tab>
</Shell>
